rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) 
        && data.email is string && data.email.size() <= 200
        && data.role in ['admin', 'manager', 'client'];
    }

    function isValidPortfolio(data) {
      return data.keys().hasAll(['ownerId', 'name']) 
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.name is string && data.name.size() <= 200;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'client'; // force client on create
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /portfolios/{portfolioId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(portfolioId) && isValidPortfolio(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(portfolioId) && isValidPortfolio(incoming()) && incoming().ownerId == existing().ownerId && (existing().ownerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(portfolioId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
